<?xml version="1.0" encoding="utf-8"?>
<!--
  Vior brand glyph — two overlapping screens (desktop + phone = second screen).
  Adaptive-icon canvas is 108x108dp; safe zone is the central 66x66 (off 21,21).
  Glyph fits centered around (54,54) with ~54 unit footprint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Desktop screen frame (white stroke) -->
    <path
        android:strokeColor="#eef1f5"
        android:strokeWidth="6"
        android:fillColor="#1a1f26"
        android:pathData="M28,32 L78,32 a4,4 0 0 1 4,4 L82,64 a4,4 0 0 1 -4,4 L28,68 a4,4 0 0 1 -4,-4 L24,36 a4,4 0 0 1 4,-4 z"/>

    <!-- Stand -->
    <path
        android:fillColor="#eef1f5"
        android:pathData="M48,68 L58,68 L58,73 L48,73 z"/>

    <!-- Base -->
    <path
        android:fillColor="#eef1f5"
        android:strokeColor="#eef1f5"
        android:strokeWidth="2"
        android:pathData="M40,75 L66,75"
        android:strokeLineCap="round"/>

    <!-- Phone (orange, overlapping bottom-right) -->
    <path
        android:fillColor="#ff8a4c"
        android:strokeColor="#0b0d10"
        android:strokeWidth="3"
        android:pathData="M64,52 L82,52 a4,4 0 0 1 4,4 L86,80 a4,4 0 0 1 -4,4 L64,84 a4,4 0 0 1 -4,-4 L60,56 a4,4 0 0 1 4,-4 z"/>

    <!-- Phone notch / indicator -->
    <path
        android:fillColor="#ffffff"
        android:fillAlpha="0.65"
        android:pathData="M70,78 L76,78 L76,80 L70,80 z"/>
</vector>
